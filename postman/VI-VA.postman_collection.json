    {
      "name": "4 · Single-shot checks",
      "description": "Each of these is self-contained — run in any order, no session needed.",
      "item": [
        {
          "name": "Emergency → escalated, never reaches EDITH (R13)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('escalated', () => pm.expect(r.status).to.eql('escalated'));",
                  "pm.test('tells them to call 112', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.include('one one two'));",
                  "pm.test('states that nothing was booked', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.include('not booked'));",
                  "// Short-circuited before the link, so this never crosses BAND at all.",
                  "pm.test('answered instantly', () =>",
                  "  pm.expect(pm.response.responseTime).to.be.below(300));",
                  "console.log('Now check GET /log?since=0 — this turn must NOT appear.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"My father has chest pain\",\n  \"session_id\": \"emergency-check\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },

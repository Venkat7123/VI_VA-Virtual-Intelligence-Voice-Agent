# ---- Vision server ----
PORT=3000
PUBLIC_URL=http://localhost:3000
# P1 (R14): passcode gate on the public demo URL. Leave blank to disable.
DEMO_PASSCODE=

# ---- BAND (agent-to-agent) ----
# Register TWO Vision agents so the laptop and Agent37 never run the same one.
# Local recording -> BAND_AGENT_ID=Vision-local ; Agent37 -> BAND_AGENT_ID=Vision-demo
BAND_AGENT_ID=Vision-local
BAND_API_KEY=
# No room ID: rooms are assigned in the BAND dashboard, not in code.
# The agent Vision @mentions, as a UUID. BAND only delivers a message to a
# mentioned agent, and an empty mentions array is rejected with 422.
# Leave blank until Member B sends it: the scripts fall back to B_AGENT_ID.
EDITH_AGENT_ID=

# ---- Second agent: the throwaway EDITH stub (scripts/edith-stub.ts) ----
# Register a 2nd agent at app.band.ai and put it in the same room as Vision.
B_AGENT_ID=
B_API_KEY=

# Groq powers the stub only. Not a sponsor, not used in the real EDITH.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# How long Vision waits for EDITH before saying something holding. Must stay
# BELOW Lyzr's tool-call timeout. A BAND round trip measures ~3.5s typical with
# outliers past 12s -- see context/latency.md.
EDITH_TIMEOUT_MS=12000

# Run with the in-process fake EDITH: no BAND, no stub needed.
# VISION_FAKE_EDITH=1

# ---- Lyzr (voice) ----
LYZR_API_KEY=
LYZR_AGENT_ID=

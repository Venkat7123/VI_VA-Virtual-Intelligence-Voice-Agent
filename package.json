{
  "name": "vi-va",
  "version": "0.1.0",
  "private": true,
  "description": "VI-VA — Virtual Intelligence Voice Agent. Vision (voice + conversation) and EDITH (booking) talking over BAND.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "band:echo": "tsx scripts/band-echo.ts",
    "band:a2a": "tsx scripts/band-a2a.ts",
    "edith:stub": "tsx scripts/edith-stub.ts",
    "dev:vision": "tsx watch vision/src/server.ts",
    "start:vision": "node --experimental-strip-types vision/src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@band-ai/sdk": "^2.2.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

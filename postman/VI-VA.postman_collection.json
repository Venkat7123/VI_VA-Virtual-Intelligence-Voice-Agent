          "name": "Unknown field → stripped, not rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fastify defaults to removeAdditional:true, so `additionalProperties:false`",
                  "// STRIPS an unknown field rather than 400-ing. That is what we want here:",
                  "// if Lyzr decides to send an extra field, the voice call survives it.",
                  "pm.test('tolerated, not rejected', () => pm.response.to.have.status(200));",
                  "pm.test('still answers normally', () =>",
                  "  pm.expect(pm.response.json().say).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"hello\",\n  \"not_a_field\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }

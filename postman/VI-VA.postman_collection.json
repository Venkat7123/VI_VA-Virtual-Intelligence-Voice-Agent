    {
      "name": "5 · Inspect",
      "item": [
        {
          "name": "GET /healthz — which EDITH am I talking to?",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('up', () => pm.expect(r.ok).to.be.true);",
                  "console.log('EDITH: ' + r.edith + '   (band = real two-agent chain, fake = in-process double)');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/healthz", "host": ["{{base}}"], "path": ["healthz"] }
          }
        },
        {
          "name": "GET /log?since=0 — every BAND hop, phone masked (R4)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const raw = pm.response.text();",
                  "// R4 + R9: the log is served to a browser, so it must never carry PII.",
                  "pm.test('no bare ten-digit phone number anywhere in the log', () =>",
                  "  pm.expect(/\\\"phone\\\":\\\"[0-9]{10}\\\"/.test(raw)).to.be.false);",
                  "pm.test('no caller name in the log', () =>",
                  "  pm.expect(raw).to.not.include('Venkat'));",
                  "console.log(r.entries.length + ' entries, latest seq ' + r.latest);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/log?since=0",
              "host": ["{{base}}"],
              "path": ["log"],
              "query": [{ "key": "since", "value": "0" }]
            }
          }
        },
        {
          "name": "GET /openapi.json — the spec Lyzr imports",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('OpenAPI 3.0.3', () => pm.expect(r.openapi).to.eql('3.0.3'));",
                  "pm.test('the tool is named ask_edith', () =>",
                  "  pm.expect(r.paths['/tools/ask_edith'].post.operationId).to.eql('ask_edith'));",
                  "console.log('server url Lyzr will call: ' + r.servers[0].url);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/openapi.json", "host": ["{{base}}"], "path": ["openapi.json"] }
          }
        }
      ]
    }
  ]

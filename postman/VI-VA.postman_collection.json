              "mode": "raw",
              "raw": "{\n  \"user_said\": \"actually make it Fortis Adyar\",\n  \"session_id\": \"{{sid_change}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }

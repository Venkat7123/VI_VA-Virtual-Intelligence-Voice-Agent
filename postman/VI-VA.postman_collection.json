{
  "info": {
    "name": "VI-VA — Vision",
    "description": "Tests the endpoint the Lyzr voice agent calls.\n\nSet the `base` variable, or import one of the environment files:\n  - http://localhost:3001 — fake EDITH, deterministic, 150ms. Use this to verify the conversation flow.\n  - http://localhost:3000 — real BAND + EDITH stub. Use this to prove the agent-to-agent hop and to measure latency. The stub is STATELESS, so the multi-turn folders will not pass against it.\n\nEvery multi-turn folder mints its own session id in its first request, so each Collection Runner run is a clean conversation. Run folders in order; single-shot checks can run in any order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3001", "type": "string" },
    { "key": "sid_book", "value": "", "type": "string" },
    { "key": "sid_decline", "value": "", "type": "string" },
    { "key": "sid_change", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request in the collection.",
          "// EDITH_TIMEOUT_MS is 12000; Lyzr must never be left waiting longer.",
          "pm.test('responded inside the 12s budget', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(13000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 · Booking flow — run in order",
      "description": "The happy path, seven turns on one session id. Turns 1-3 are EDITH's answers (wording varies by implementation, so only the status is asserted). Turns 4-7 are Vision's own confirm flow (R8, R9) and their wording is fixed.",
      "item": [
        {
          "name": "T1 · Apollo → expect a branch question",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh session per run, so nothing carries over from the last one.",
                  "pm.collectionVariables.set('sid_book', 'book-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('session id echoed back', () =>",
                  "  pm.expect(r.session_id).to.eql(pm.collectionVariables.get('sid_book')));",
                  "pm.test('asks which branch', () =>",
                  "  pm.expect(r.status).to.be.oneOf(['needs_choice', 'needs_info']));",
                  "pm.test('has something sayable', () => pm.expect(r.say).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"I want an appointment at Apollo\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T2 · the OMR one → expect a day/time question",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('moved on from the branch question', () =>",
                  "  pm.expect(r.status).to.be.oneOf(['needs_info', 'needs_confirm']));",
                  "// If this says 'which branch?' again, EDITH is not holding session state.",
                  "pm.test('did not re-ask the branch', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.not.include('which one'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"the OMR one\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T3 · tomorrow evening → expect a slot to confirm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('offers a slot for confirmation', () =>",
                  "  pm.expect(r.status).to.eql('needs_confirm'));",
                  "pm.test('names the branch it was told', () =>",
                  "  pm.expect(r.say).to.include('OMR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"tomorrow evening\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T4 · yes → R8 gate opens, asks for a name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('asks for a name', () => {",
                  "  pm.expect(r.status).to.eql('needs_info');",
                  "  pm.expect(r.say.toLowerCase()).to.include('name');",
                  "});",
                  "// R9: nothing is booked yet. Personal data is collected only now.",
                  "pm.test('nothing booked yet', () => pm.expect(r.status).to.not.eql('booked'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"yes\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T5 · my name is Venkat → asks for the phone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('strips the lead-in and uses the bare name', () =>",
                  "  pm.expect(r.say).to.include('Venkat'));",
                  "pm.test('asks for ten digits', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.include('ten digit'));",
                  "// Answered by Vision itself - this turn never touches BAND.",
                  "pm.test('answered locally, fast', () =>",
                  "  pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"my name is Venkat\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T6 · +91 9876543210 → R9 digit-by-digit read-back",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('reads the number back one digit at a time', () => {",
                  "  pm.expect(r.status).to.eql('needs_confirm');",
                  "  pm.expect(r.say).to.include('9 8 7 6 5 4 3 2 1 0');",
                  "});",
                  "pm.test('+91 was stripped to ten digits', () =>",
                  "  pm.expect(r.say).to.not.include('9 1 9 8'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"+91 9876543210\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        },
        {
          "name": "T7 · yes → booked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('booked', () => pm.expect(r.status).to.eql('booked'));",
                  "pm.test('gives a reference back', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.include('reference'));",
                  "console.log('Now check GET /log?since=0 — the confirm line must show \"name\":\"<name>\" and a masked phone.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_said\": \"yes\",\n  \"session_id\": \"{{sid_book}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base}}/tools/ask_edith",
              "host": ["{{base}}"],
              "path": ["tools", "ask_edith"]
            }
          }
        }
      ]
    },
    {

        {
          "name": "C4 · actually make it Fortis Adyar → forwarded, not trapped",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('not treated as a yes or a no', () =>",
                  "  pm.expect(r.say.toLowerCase()).to.not.include('please say yes or no'));",
                  "pm.test('the correction reached EDITH', () =>",
                  "  pm.expect(r.say).to.include('Fortis'));",
